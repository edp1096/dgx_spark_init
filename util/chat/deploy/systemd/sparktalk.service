[Unit]
Description=SparkTalk web application
After=network-online.target llama-cpp-spark.service
Wants=network-online.target llama-cpp-spark.service

[Service]
Type=simple
WorkingDirectory=%h/workspace/dgx_spark_init/util/chat/dist
ExecStart=%h/workspace/dgx_spark_init/util/chat/dist/sparktalk-linux-arm64
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
