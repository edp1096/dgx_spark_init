# Required only when the gated official LTX-2.5 files are not already present.
# First accept https://huggingface.co/Lightricks/LTX-2.5 with this account.
HF_TOKEN=hf_replace_with_your_read_token

# The public Motion LoRA is downloaded automatically. Leave the path blank to
# keep the official model behavior, or uncomment it to apply the LoRA globally.
# LTX_LORA_PATH=/models/ltx-2.5/loras/ltx-2.3-ltx2-better-nsfw-motion.safetensors
LTX_LORA_STRENGTH=0.5
