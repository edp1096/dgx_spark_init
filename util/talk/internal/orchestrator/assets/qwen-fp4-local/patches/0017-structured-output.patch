diff --git a/zig/src/core/lanes/constraint.zig b/zig/src/core/lanes/constraint.zig
new file mode 100644
index 0000000..bdc46f2
--- /dev/null
+++ b/zig/src/core/lanes/constraint.zig
@@ -0,0 +1,63 @@
+//! CPU grammar state for explicitly structured requests; ordinary lanes never load Python.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+pub const Spec = struct {
+    kind: enum { json, json_schema, regex, choice, grammar },
+    text: []const u8 = "",
+    after: ?u32 = null,
+};
+const Create = *const fn ([*:0]const u8, [*:0]const u8, [*:0]const u8) callconv(.c) ?*anyopaque;
+const Mask = *const fn (*anyopaque, [*]const u32, usize, [*]u32, usize) callconv(.c) c_int;
+const Free = *const fn (*anyopaque) callconv(.c) void;
+const Bridge = struct { lib: std.DynLib, create: Create, mask: Mask, free: Free };
+// LaneHost owns one engine thread. Keep the interpreter/library alive until process exit.
+var library: ?Bridge = null;
+fn bridge() !*Bridge {
+    if (library == null) {
+        const path = std.c.getenv("TENSORFOLD_STRUCTURE_BRIDGE") orelse return error.StructureLibraryMissing;
+        var lib = try std.DynLib.open(std.mem.span(path));
+        errdefer lib.close();
+        library = .{ .lib = lib, .create = lib.lookup(Create, "tf_structure_create") orelse return error.StructureSymbolMissing, .mask = lib.lookup(Mask, "tf_structure_mask") orelse return error.StructureSymbolMissing, .free = lib.lookup(Free, "tf_structure_free") orelse return error.StructureSymbolMissing };
+    }
+    return &library.?;
+}
+pub const Constraint = struct {
+    gpa: Allocator,
+    state: *anyopaque,
+    bits: []u32,
+    pending: std.ArrayList(u32) = .empty,
+    after: ?u32,
+    active: bool,
+    pub fn init(gpa: Allocator, spec: Spec) !Constraint {
+        const lib = try bridge();
+        const model = std.c.getenv("TENSORFOLD_STRUCTURE_MODEL") orelse return error.StructureModelMissing;
+        const text = try gpa.dupeSentinel(u8, spec.text, 0);
+        defer gpa.free(text);
+        const kind = try gpa.dupeSentinel(u8, @tagName(spec.kind), 0);
+        defer gpa.free(kind);
+        const state = lib.create(model, kind, text) orelse return error.InvalidStructure;
+        errdefer lib.free(state);
+        // Refuse oversized vocabularies rather than truncating their mask.
+        const bits = try gpa.alloc(u32, 32768);
+        return .{ .gpa = gpa, .state = state, .bits = bits, .after = spec.after, .active = spec.after == null };
+    }
+    pub fn deinit(c: *Constraint) void {
+        library.?.free(c.state);
+        c.gpa.free(c.bits);
+        c.pending.deinit(c.gpa);
+    }
+    pub fn accept(c: *Constraint, token: u32) !void {
+        if (!c.active) {
+            if (c.after == token) c.active = true;
+            return;
+        }
+        try c.pending.append(c.gpa, token);
+    }
+    pub fn mask(c: *Constraint) !?[]const u32 {
+        if (!c.active) return null;
+        const words = library.?.mask(c.state, c.pending.items.ptr, c.pending.items.len, c.bits.ptr, c.bits.len);
+        if (words <= 0 or words > c.bits.len) return error.GrammarMaskFailed;
+        c.pending.clearRetainingCapacity();
+        return c.bits[0..@intCast(words)];
+    }
+};
