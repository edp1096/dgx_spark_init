+    // Structured requests use serial verification. Restore logits after every
+    // masked draw so neither prompt reuse nor another request inherits a mask.
+    fn maskedDraw(e: *Engine, logits: u64, position: u64, sampling: ?lanes.Sampling, bits: []const u32, out: []u32) !void {
+        if (e.world != 1 or out.len != 1) return error.StructureRequiresSerialTP1;
+        const width = e.g.head_n;
+        if (bits.len * 32 < width) return error.GrammarVocabularyMismatch;
+        const original = try e.gpa.alloc(u16, width);
+        defer e.gpa.free(original);
+        try e.read(logits, std.mem.sliceAsBytes(original));
+        const masked = try e.gpa.dupe(u16, original);
+        defer e.gpa.free(masked);
+        var any = false;
+        for (masked, 0..) |*value, id| {
+            const allowed = (bits[id / 32] & (@as(u32, 1) << @as(u5, @intCast(id % 32)))) != 0;
+            if (!allowed) value.* = 0xff80 else any = true;
+        }
+        if (!any) return error.EmptyGrammarMask;
+        const device: cuda.DeviceBuffer = .{ .d = e.ctx.d, .ptr = logits, .len = width * 2 };
+        try device.upload(0, std.mem.sliceAsBytes(masked));
+        errdefer device.upload(0, std.mem.sliceAsBytes(original)) catch {};
+        const s = if (sampling) |x| (if (x.temperature > 0) sampling else null) else null;
+        try e.drawRows(logits, 0, 1, 0, 1, position, s, out);
+        try device.upload(0, std.mem.sliceAsBytes(original));
+    }
+    pub fn sampleFirstMasked(e: *Engine, sampling: ?lanes.Sampling, position: u64, bits: []const u32) !u32 {
+        var token: [1]u32 = undefined;
+        try e.maskedDraw(e.last_logits, position, sampling, bits, &token);
+        return token[0];
+    }
+    pub fn sampleWindowMasked(e: *Engine, i: usize, sampling: ?lanes.Sampling, out: []u32, bits: []const u32) !void {
+        if (i >= e.round_n) return error.NoSuchWindow;
+        const sg = e.round_segs[i];
+        if (sg.a1 - sg.a0 != 1) return error.StructureRequiresSerialTP1;
+        try e.maskedDraw(e.buf.b.logits + sg.a0 * e.g.head_n * 2, sg.seq.st.pos + 1, sampling, bits, out);
+    }
+
