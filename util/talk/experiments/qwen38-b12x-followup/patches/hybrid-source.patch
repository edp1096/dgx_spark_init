--- a/zig/src/families/flashnext/cuda_b12x.zig
+++ b/zig/src/families/flashnext/cuda_b12x.zig
@@ -0,0 +1,27 @@
+//! Experimental B12X bridge. Disabled unless TF_B12X_BRIDGE names a shared library.
+const std = @import("std");
+const Load = *const fn ([*:0]const u8) callconv(.c) u64;
+const Run = *const fn (u64, u64, u64, u64, u64, u64, c_int, c_int, c_int, c_int) callconv(.c) c_int;
+var lib: ?std.DynLib = null;
+var load_fn: ?Load = null;
+var run_fn: ?Run = null;
+pub fn enabled() bool { return std.c.getenv("TF_B12X_BRIDGE") != null; }
+pub fn load(name: []const u8) !u64 {
+    if (lib == null) {
+        const path = std.c.getenv("TF_B12X_BRIDGE") orelse return error.B12xDisabled;
+        lib = try std.DynLib.open(std.mem.span(path));
+        load_fn = lib.?.lookup(Load, "tf_b12x_load") orelse return error.B12xSymbol;
+        run_fn = lib.?.lookup(Run, "tf_b12x_run") orelse return error.B12xSymbol;
+    }
+    var buf: [512]u8 = undefined;
+    if (name.len >= buf.len) return error.B12xName;
+    @memcpy(buf[0..name.len], name);
+    buf[name.len] = 0;
+    const id = load_fn.?(@ptrCast(&buf));
+    if (id == 0) return error.B12xLoad;
+    return id;
+}
+pub fn run(id: u64, stream: ?*anyopaque, x: u64, picks: u64, wts: u64, y: u64, rows: usize, hidden: usize, top: usize, es: usize) !void {
+    const rc = run_fn.?(id, @intFromPtr(stream), x, picks, wts, y, @intCast(rows), @intCast(hidden), @intCast(top), @intCast(es));
+    if (rc != 0) { std.log.err("B12X run failed code={d}", .{rc}); return error.B12xRun; }
+}
