# Copy to .env on BOTH Sparks. Keep the file identical on both nodes.

# Management/LAN addresses. Model synchronization uses this network; vLLM
# tensor-parallel traffic uses the dedicated rail below.
HEAD_LAN_IP=192.168.100.61
WORKER_LAN_IP=192.168.100.60
WORKER_USER=edp1096

# Direct 200 GbE/QSFP rail. These are example static addresses; configure them
# on the two hosts and verify the actual port/HCA names before starting.
HEAD_RAIL_IP=10.200.0.1
WORKER_RAIL_IP=10.200.0.2
HEAD_NCCL_IF=enp1s0f1np1
WORKER_NCCL_IF=enp1s0f1np1
HEAD_NCCL_HCA=rocep1s0f1
WORKER_NCCL_HCA=rocep1s0f1
NCCL_SUBNET=10.200.0.0/24
# Normally detected from sysfs. Set only if automatic detection fails.
#NCCL_IB_GID_INDEX=3

# Pinned Entrpi runtime. Change deliberately and retest before deploying.
GLM53_IMAGE=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v2.3-tier1

# Each node keeps a local copy of both checkpoints. Change EXL3_REPO and
# MODEL_HOST_PATH together; never download a different model into the same path.
EXL3_REPO=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_HOST_PATH=/home/edp1096/.cache/huggingface/glm53-exl3
# EXL3_REPO=lovesenko/GLM-5.3-Flash-tr3-4bpw-Abliterated
# MODEL_HOST_PATH=/home/edp1096/.cache/huggingface/glm53-exl3-abliterated
DFLASH_HOST_PATH=/home/edp1096/.cache/huggingface/glm53-dflash2-mxfp8
GLM53_CACHE_PATH=/home/edp1096/.cache/glm53-vllm

# Optional load-time BF16 o_proj transplant from the public Lovesenko donor.
# Lovesenko layers 0-44 (3.5 GiB), original MTP retained.
ABLIT=0
ABLIT_HOST_PATH=/home/edp1096/.cache/huggingface/glm53-lovesenko-oproj
ABLIT_DONOR=lovesenko/GLM-5.3-Flash-tr3-4bpw-Abliterated
ABLIT_DONOR_REVISION=c8f58e6aa9117c73607d692978b22f091d80450c
ABLIT_LAYERS=0-44
ABLIT_INCLUDE_MTP=0

HOST_UID=1000
HOST_GID=1000
REMOTE_COMPOSE_DIR=/home/edp1096/workspace/dgx_spark_init/compose_yaml/vllm_glm53f

# Entrpi's validated default profile: full-quality fp8_ds_mla KV, 524K max.
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_MEMORY=14400000000
KV_CACHE_DTYPE=fp8_ds_mla
ATTENTION_BACKEND=B12X_MLA_SPARSE
KV_CACHE_DTYPE_SKIP_LAYERS=sliding_window
BLOCK_SIZE=2304
LOAD_FORMAT=instanttensor
PREFIX_MATCH_UNIT=512

# DFlash2 is CC BY-NC-ND 4.0 (research/evaluation only).
SPEC_METHOD=dflash
MTP_TOKENS=0
DFLASH_TOKENS=7

API_PORT=8000
MASTER_PORT=29521
NCCL_NCHANNELS=8
NCCL_DEBUG=WARN

# Optional: preserve interactive decode speed while a long prompt is prefilling.
#MIXED_PREFILL_DECODE_WEIGHT=1.0
#MIXED_PREFILL_CAP=512

# Commercial/no-DFlash profile:
#SPEC_METHOD=none
#MTP_TOKENS=4

MODEL_KIND=glm53
MODEL_VARIANT=official
