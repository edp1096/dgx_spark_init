[
  "serve",
  "@MODEL_HOST_PATH@",
  "--chat-template",
  "/root/.cache/glm53-chat.jinja",
  "--served-model-name",
  "@SERVED_MODEL_NAME@",
  "--host",
  "@API_BIND@",
  "--port",
  "@API_PORT@",
  "--tensor-parallel-size",
  "2",
  "--decode-context-parallel-size",
  "1",
  "--mamba-cache-mode",
  "align",
  "--enable-prefix-caching",
  "--enable-prompt-tokens-details",
  "--enable-chunked-prefill",
  "--dtype",
  "bfloat16",
  "--kv-cache-dtype",
  "fp8",
  "--kv-cache-memory-bytes",
  "8589934592",
  "--quantization",
  "modelopt_mixed",
  "--attention-backend",
  "B12X",
  "--block-size",
  "256",
  "--moe-backend",
  "b12x",
  "--linear-backend",
  "b12x",
  "--no-enable-flashinfer-autotune",
  "--load-format",
  "b12x",
  "--max-model-len",
  "1048576",
  "--max-num-seqs",
  "1",
  "--max-num-batched-tokens",
  "4096",
  "--speculative-config",
  "{\"method\": \"mtp\", \"num_speculative_tokens\": 5, \"moe_backend\": \"humming\", \"attention_backend\": \"B12X\"}",
  "--reasoning-parser",
  "glm45",
  "--tool-call-parser",
  "glm47",
  "--enable-auto-tool-choice",
  "--gpu-memory-utilization",
  "0.87",
  "--nnodes",
  "2",
  "--master-addr",
  "@HEAD_RAIL_IP@",
  "--master-port",
  "@MASTER_PORT@",
  "--node-rank",
  "@NODE_RANK@"
]
