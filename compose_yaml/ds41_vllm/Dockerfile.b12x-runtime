FROM dgx-ds41-stream:b12x-dev
# Preserve the tested transport library; b12x itself does not require a downgrade.
RUN pip install --no-deps --no-cache-dir nvidia-nccl-cu13==2.30.7
COPY patches /opt/ds41/patches
COPY *.py /opt/ds41/
COPY tools /opt/ds41/tools
RUN while read src dst; do if [ -n "$src" ]; then cp "/opt/ds41/patches/$src" "/usr/local/lib/python3.12/dist-packages/vllm/$dst"; fi; done < /opt/ds41/patches/mounts.txt
ENV VLLM_PLUGINS=""
