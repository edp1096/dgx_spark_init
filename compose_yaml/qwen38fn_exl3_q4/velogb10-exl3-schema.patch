+    /// Stage token bitsets in scratch-row order. Ordinary traffic pays no allocation/upload.
+    /// Constrained requests use plain GPU decoding, so masks never reach speculative graphs.
+    pub fn set_schema_masks(&self, sc: &mut Scratch, rows: &[Option<Arc<Vec<u32>>>]) -> Result<()> {
+        sc.schema_live = rows.iter().any(Option::is_some);
+        if !sc.schema_live { return Ok(()); }
+        let words = crate::json_schema::vocab_words(self.cfg.vocab_size);
+        anyhow::ensure!(rows.len() <= sc.schema_flags.len(), "schema rows exceed scratch width");
+        let mut bits = vec![0u32; sc.schema_bits.len()];
+        let mut flags = vec![0i32; sc.schema_flags.len()];
+        for (r, mask) in rows.iter().enumerate() {
+            if let Some(mask) = mask {
+                anyhow::ensure!(mask.len() <= words, "schema mask exceeds vocabulary");
+                anyhow::ensure!(mask.iter().any(|&w| w != 0), "JSON schema has no legal next token");
