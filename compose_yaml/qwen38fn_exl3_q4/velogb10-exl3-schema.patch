@@ -0,0 +1,48 @@
+use anyhow::{ensure, Result};
+use cudarc::driver::{CudaDevice, LaunchAsync, LaunchConfig};
+use half::f16;
+
+#[test]
+#[ignore = "requires GB10 CUDA and rebuilt EXL3 PTX"]
+fn masked_fp16_rows_and_device_sampling() -> Result<()> {
+    let dev = CudaDevice::new(0)?;
+    dev.load_ptx(cudarc::nvrtc::Ptx::from_src(std::fs::read_to_string("src/ptx/exl3_bench.ptx")?),
+                 "schema_test", &["xq_schema_rows", "xq_sample_rows"])?;
+    let mut count = 0;
+    for v in [65usize, 257, 248320] {
+        let words = v.div_ceil(32);
+        // Three simultaneous rows: independent masks and an entirely unconstrained row.
+        let flags = dev.htod_sync_copy(&[1i32, 0, 1])?;
+        let mut bits = vec![0u32; 3 * words];
+        let allowed = [vec![2usize, 35, v-1], (0..v).collect(), vec![1usize, 32, v-2]];
+        for row in [0usize, 2] { for &i in &allowed[row] { bits[row*words+i/32] |= 1 << (i%32); } }
+        let bits = dev.htod_sync_copy(&bits)?;
+        let original: Vec<u16> = (0..3*v).map(|i| f16::from_f32(((i*13)%51) as f32/8.0).to_bits()).collect();
+        let mut logits = dev.htod_sync_copy(&original)?;
+        unsafe { dev.get_func("schema_test", "xq_schema_rows").unwrap().launch(
+            LaunchConfig { grid_dim:(v.div_ceil(256) as u32,3,1),block_dim:(256,1,1),shared_mem_bytes:0 },
+            (&mut logits,v as i32,&bits,&flags,words as i32))?; }
+        let got = dev.dtoh_sync_copy(&logits)?;
+        for row in 0..3 { for i in 0..v {
+            let expected = if row==1 || allowed[row].contains(&i) { original[row*v+i] } else { f16::NEG_INFINITY.to_bits() };
+            ensure!(got[row*v+i]==expected,"mask changed a legal logit or left a forbidden logit: row={row} i={i} v={v}");
+        }}
+        // Both low and high temperature/top-k modes sample ONLY from legal tokens.
+        for (temp,top_k,top_p,min_p) in [(0.7f32,20u32,0.8f32,0f32),(1.5,0,1.0,0.1)] {
+            for seed in 0..8u32 {
+                let mut params=Vec::new();
+                for row in 0..3u32 { params.extend_from_slice(&[1,temp.to_bits(),top_p.to_bits(),top_k,seed,0,row,min_p.to_bits()]); }
+                let samp=dev.htod_sync_copy(&params)?; let mut ids=dev.htod_sync_copy(&[-1i32;3])?;
+                unsafe { dev.get_func("schema_test","xq_sample_rows").unwrap().launch(
+                    LaunchConfig {grid_dim:(3,1,1),block_dim:(1024,1,1),shared_mem_bytes:0},
+                    (&mut ids,&logits,v as i32,&samp))?; }
+                for (row,&id) in dev.dtoh_sync_copy(&ids)?.iter().enumerate() {
+                    ensure!(id>=0 && allowed[row].contains(&(id as usize)),"sample escaped schema: row={row} id={id} v={v}");
+                    count+=1;
+                }
+            }
+        }
+    }
+    println!("SCHEMA_GPU_PASS sampled_rows={count}");
+    Ok(())
+}
