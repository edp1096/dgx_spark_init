@@ -0,0 +1,66 @@
+use anyhow::{ensure, Result};
+use gb10_inference::{exl3_schema::Cursor, json_schema::compile_response_format, tokenizer::QwenTokenizer};
+use std::sync::Arc;
+
+#[test]
+#[ignore = "requires VELO_TOKENIZER_PATH pointing to the cached real tokenizer.json"]
+fn real_bpe_pieces_match_json_bytes_and_exclude_specials() -> Result<()> {
+    let path = std::env::var("VELO_TOKENIZER_PATH")?;
+    let tok = QwenTokenizer::from_file(&path)?;
+    let pieces = tok.vocab_pieces();
+    let mut passed = 0;
+    for value in ["펭귄", "한글😀", "인용\"\\줄\n", " 일본語 中文", "\t\r\n", ""] {
+        let doc = serde_json::json!({"value":value});
+        let raw = serde_json::to_string(&doc)?;
+        let rf = serde_json::json!({"type":"json_schema","json_schema":{"name":"real","schema":{
+            "type":"object", "properties":{"value":{"type":"string","enum":[value]}},
+            "required":["value"],"additionalProperties":false
+        }}});
+        let mut sm = compile_response_format(&rf).map_err(anyhow::Error::msg)?.unwrap();
+        sm.set_compact();
+        sm.set_vocab(pieces.clone());
+        let mut cursor = Cursor::new(Arc::new(sm));
+        let ids = tok.encode(&raw, false)?;
+        for (i,&id) in ids.iter().enumerate() {
+            ensure!(cursor.commit(id)? == (i+1==ids.len()), "completion changed before JSON ended");
+        }
+        ensure!(tok.decode(&ids,true)?==raw,"tokenizer round trip changed the document");
+        passed+=1;
+    }
+    for id in tok.stop_token_ids(248046) {
+        ensure!(pieces.iter().find(|(i,_)|*i==id).is_some_and(|(_,b)|b.is_empty()),"stop token can leak into JSON");
+    }
+    println!("SCHEMA_REAL_TOKENIZER_PASS cases={passed}");
+    Ok(())
+}
+
+#[test]
+#[ignore = "requires VELO_TOKENIZER_PATH pointing to the cached real tokenizer.json"]
+fn real_bpe_random_guidance_always_completes() -> Result<()> {
+    let tok=QwenTokenizer::from_file(&std::env::var("VELO_TOKENIZER_PATH")?)?;
+    let pieces=tok.vocab_pieces();
+    let rf=serde_json::json!({"type":"json_schema","json_schema":{"name":"random","schema":{
+        "type":"object","properties":{"a":{"type":"string","enum":["한글😀","alpha"]},
+        "b":{"type":"array","items":{"type":"integer","enum":[1,12,391]},"minItems":2,"maxItems":2}},
+        "required":["a","b"],"additionalProperties":false
+    }}});
+    let mut sm=compile_response_format(&rf).map_err(anyhow::Error::msg)?.unwrap();sm.set_compact();sm.set_vocab(pieces.clone());let sm=Arc::new(sm);
+    for seed in 1..=32u64 {
+        let mut c=Cursor::new(sm.clone());let mut rnd=seed;let mut bytes=Vec::new();let mut ids=Vec::new();let mut done=false;
+        for _ in 0..256 {
+            let bits=c.allowed();let mut legal=Vec::new();
+            for (w,&word) in bits.iter().enumerate() { let mut mask=word;while mask!=0 {
+                let i=w*32+mask.trailing_zeros() as usize;mask&=mask-1;
+                if !pieces[i].1.iter().all(u8::is_ascii_whitespace) { legal.push(i as u32); }
+            }}
+            ensure!(!legal.is_empty(),"real BPE dead end: {:?}",String::from_utf8_lossy(&bytes));
+            rnd=rnd.wrapping_mul(6364136223846793005).wrapping_add(1);let t=legal[rnd as usize%legal.len()];
+            bytes.extend_from_slice(&pieces[t as usize].1);ids.push(t);done=c.commit(t)?;if done {break;}
+        }
+        ensure!(done,"random BPE path did not finish");
+        let doc:serde_json::Value=serde_json::from_slice(&bytes)?;
+        ensure!(matches!(doc["a"].as_str(),Some("한글😀"|"alpha")) && doc["b"].as_array().is_some_and(|v|v.len()==2 && v.iter().all(|x|matches!(x.as_i64(),Some(1|12|391)))),"random JSON violated schema");
+        ensure!(tok.decode(&ids,true)?.as_bytes()==bytes,"wire decoder changed JSON bytes");
+    }
+    println!("SCHEMA_REAL_BPE_RANDOM_PASS cases=32");Ok(())
+}
