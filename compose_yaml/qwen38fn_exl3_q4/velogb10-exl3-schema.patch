@@ -0,0 +1,58 @@
+//! Per-request constraint state. Validate tokens before they can reach the HTTP stream.
+use crate::json_schema::SchemaMask;
+use anyhow::{Context, Result};
+use std::sync::Arc;
+
+pub struct Cursor {
+    schema: Arc<SchemaMask>,
+    state: u32,
+}
+
+impl Cursor {
+    pub fn new(schema: Arc<SchemaMask>) -> Self {
+        Self { state: schema.start_state(), schema }
+    }
+
+    pub fn allowed(&self) -> Arc<Vec<u32>> { self.schema.allowed(self.state) }
+
+    pub fn commit(&mut self, token: u32) -> Result<bool> {
+        let mask = self.allowed();
+        anyhow::ensure!(mask.get(token as usize / 32).is_some_and(|w| w & (1u32 << (token % 32)) != 0),
+                        "schema sampler selected forbidden token {token}");
+        self.state = self.schema.step(self.state, token)
+            .context("schema token did not advance the JSON machine")?;
+        Ok(self.schema.is_complete(self.state))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn cursor() -> Cursor {
+        let mut sm = crate::json_schema::compile_response_format(&serde_json::json!({
+            "type":"json_schema", "json_schema":{"name":"t", "schema":{
+                "type":"object", "properties":{"a":{"type":"string","enum":["한글"]}},
+                "required":["a"], "additionalProperties":false
+            }}
+        })).unwrap().unwrap();
+        sm.set_vocab((0..256u32).map(|b| (b, vec![b as u8])).collect());
+        Cursor::new(Arc::new(sm))
+    }
+    #[test]
+    fn utf8_and_completion_are_request_local() {
+        let mut a = cursor(); let mut b = cursor();
+        let bytes = "{\"a\":\"한글\"}".as_bytes();
+        for (i, &t) in bytes.iter().enumerate() {
+            assert_eq!(a.commit(t as u32).unwrap(), i + 1 == bytes.len());
+        }
+        assert!(!b.commit(b'{' as u32).unwrap());
+        assert!(a.commit(b'N' as u32).is_err());
+    }
+    #[test]
+    fn forbidden_token_does_not_advance() {
+        let mut c = cursor();
+        assert!(c.commit(b'N' as u32).is_err());
+        assert!(!c.commit(b'{' as u32).unwrap());
+        assert!(c.commit(248046).is_err());
+    }
+}
