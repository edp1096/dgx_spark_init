+// Request-specific JSON vocabulary masks, AFTER penalties and BEFORE any selection.
+// The EXL3 logits are fp16 (the NVFP4 mask kernel's bf16 ABI must not be reused).
+extern "C" __global__ void xq_schema_rows(__half* logits, int V,
+    const unsigned* bits, const int* flags, int words) {
+    XQ_PDL_ENTRY();
+    int row = blockIdx.y, i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < V && flags[row] && !(bits[(long long)row * words + (i >> 5)] & (1u << (i & 31))))
+        logits[(long long)row * V + i] = __float2half(-INFINITY);
 }
 
