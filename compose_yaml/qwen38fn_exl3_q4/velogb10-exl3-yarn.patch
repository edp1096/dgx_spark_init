+use gb10_inference::exl3_rope::Rope;
+fn main() -> anyhow::Result<()> {
+    let r = Rope::new(64, 1e7, 262144, 4.0, 32.0, 1.0, None, true)?;
+    let positions = [0, 1, 2048, 262143, 262144, 524287, 1048575, 1048576];
+    println!("{}", serde_json::json!({"inv":r.inv,"scale":r.scale,"positions":positions,
+        "rows":positions.iter().map(|&p|r.row([p;3],[11,11,10])).collect::<Vec<_>>(),
+        "mrope":r.row([262143,524287,1048575],[11,11,10])}));
+    Ok(())
+}
