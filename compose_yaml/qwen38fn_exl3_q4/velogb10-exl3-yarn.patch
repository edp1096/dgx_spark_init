diff --git a/src/exl3_rope.rs b/src/exl3_rope.rs
new file mode 100644
index 0000000..bfaac29
--- /dev/null
+++ b/src/exl3_rope.rs
@@ -0,0 +1,149 @@
+//! Static YaRN for EXL3. All attention, indexer, MTP and mRoPE paths share this plan.
+use anyhow::{ensure, Result};
+
+#[derive(Debug)]
+pub struct Rope {
+    pub inv: Vec<f32>,
+    pub scale: f32,
+    pub factor: f32,
+    pub original: usize,
+}
+
+impl Rope {
+    pub fn new(dim: usize, base: f32, original: usize, factor: f32,
+               beta_fast: f64, beta_slow: f64, attention: Option<f32>, truncate: bool) -> Result<Self> {
+        ensure!(dim > 0 && dim % 2 == 0 && dim <= 255, "EXL3 rotary dimension must be even, 2..254");
+        ensure!(base.is_finite() && base > 1.0 && original > 0, "invalid EXL3 RoPE base/original context");
+        ensure!(factor.is_finite() && factor >= 1.0, "--rope-yarn-factor must be finite and >= 1");
+        ensure!(beta_fast.is_finite() && beta_slow.is_finite() && beta_fast > beta_slow && beta_slow > 0.0,
+                "YaRN requires finite beta_fast > beta_slow > 0");
+        let scale = attention.unwrap_or_else(|| if factor > 1.0 { 1.0 + 0.1 * factor.ln() } else { 1.0 });
+        ensure!(scale.is_finite() && scale > 0.0, "invalid YaRN attention_factor");
+        let inv = if factor == 1.0 {
+            // Preserve the pre-YaRN EXL3 powf order and bits.
+            (0..dim / 2).map(|i| base.powf(-(2.0 * i as f32) / dim as f32)).collect()
+        } else {
+            // HF/ExLlama convention: high-frequency extrapolation, low-frequency interpolation.
+            // Correction bounds use Python-equivalent f64; tensor arithmetic is f32.
+            let find = |rot: f64| dim as f64 * (original as f64 / (rot * 2.0 * std::f64::consts::PI)).ln()
+                / (2.0 * (base as f64).ln());
+            let mut lo = find(beta_fast);
+            let mut hi = find(beta_slow);
+            if truncate { lo = lo.floor(); hi = hi.ceil(); }
+            lo = lo.max(0.0); hi = hi.min((dim - 1) as f64);
+            if lo == hi { hi += 0.001; }
+            (0..dim / 2).map(|i| {
+                let extra = 1.0 / base.powf((2 * i) as f32 / dim as f32);
+                let interp = 1.0 / (factor * base.powf((2 * i) as f32 / dim as f32));
+                let mask = 1.0 - ((i as f32 - lo as f32) / (hi as f32 - lo as f32)).clamp(0.0, 1.0);
+                interp * (1.0 - mask) + extra * mask
+            }).collect()
+        };
+        Ok(Self { inv, scale, factor, original })
+    }
+
+    pub fn from_config(cfg: &crate::qwen::Config, json: &serde_json::Value) -> Result<Self> {
+        let tc = json.get("text_config").unwrap_or(json);
+        let rp = &tc["rope_parameters"];
+        let ty = rp["rope_type"].as_str().unwrap_or("default");
+        ensure!(matches!(ty, "default" | "mrope" | "yarn"), "unsupported EXL3 rope_type {ty}");
+        let factor = match crate::opts::var(crate::opt!("rope-yarn-factor")) {
+            Ok(s) => s.parse::<f32>().map_err(|_| anyhow::anyhow!("invalid --rope-yarn-factor: {s}"))?,
+            Err(_) if ty == "yarn" => rp["factor"].as_f64().ok_or_else(|| anyhow::anyhow!("YaRN config needs factor"))? as f32,
+            Err(_) => 1.0,
+        };
+        let original = rp["original_max_position_embeddings"].as_u64().map(|v| v as usize)
+            .unwrap_or(cfg.max_position_embeddings);
+        // These model-family-specific scale ratios require a separate attention softmax change.
+        ensure!(rp.get("mscale").is_none() && rp.get("mscale_all_dim").is_none(),
+                "EXL3 YaRN mscale ratio configs are not supported; use attention_factor");
+        Self::new(cfg.rotary_dim, cfg.rope_theta, original, factor,
+                  rp["beta_fast"].as_f64().unwrap_or(32.0), rp["beta_slow"].as_f64().unwrap_or(1.0),
+                  rp["attention_factor"].as_f64().map(|v| v as f32), rp["truncate"].as_bool().unwrap_or(true))
+    }
+
+    /// Public context excludes the server's allocation-only decode headroom.
+    pub fn validate_context(&self, context: usize) -> Result<()> {
+        ensure!(context > 0 && context as f64 <= self.original as f64 * self.factor as f64,
+                "EXL3 context {context} exceeds YaRN capacity {} (original {}, factor {}); set --rope-yarn-factor",
+                self.original as f64 * self.factor as f64, self.original, self.factor);
+        Ok(())
+    }
+
+    pub fn row(&self, p: [i64; 3], sec: [usize; 3]) -> Vec<f32> {
+        let dim = 2 * self.inv.len();
+        let mut row = vec![0.0; 2 * dim];
+        for (i, &inv) in self.inv.iter().enumerate() {
+            let axis = if i % 3 == 1 && i < 3 * sec[1] { 1 } else if i % 3 == 2 && i < 3 * sec[2] { 2 } else { 0 };
+            let f = p[axis] as f32 * inv;
+            row[i] = f.cos() * self.scale;
+            row[dim + i] = f.sin() * self.scale;
+        }
+        row
+    }
+
+    pub fn rows(&self, pos: usize, count: usize) -> Vec<f32> {
+        let mut out = Vec::with_capacity(count * self.inv.len() * 4);
+        for p in pos..pos + count { out.extend(self.row([p as i64; 3], [0; 3])); }
+        out
+    }
+}
+
+/// Keep the full 28-bit max_pos and four-bit KV format in the CUDA parameter.
+pub fn pack_geometry(dim: usize, max_pos: usize, fmt: u32) -> u64 {
+    assert!(dim < 256 && max_pos < (1 << 28) && fmt < 16);
+    dim as u64 | ((max_pos as u64 | ((fmt as u64) << 28)) << 8)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn default_rows_are_bit_exact() {
+        let r = Rope::new(64, 1e7, 262144, 1.0, 32.0, 1.0, None, true).unwrap();
+        for p in [0, 1, 2048, 262143] {
+            let row = r.row([p; 3], [11, 11, 10]);
+            for i in 0..32 {
+                let f = p as f32 * 1e7f32.powf(-(2.0 * i as f32) / 64.0);
+                assert_eq!(row[i].to_bits(), f.cos().to_bits());
+                assert_eq!(row[64+i].to_bits(), f.sin().to_bits());
+            }
+        }
+    }
+    #[test]
+    fn context_and_geometry_boundaries() {
+        let r = Rope::new(64, 1e7, 262144, 4.0, 32.0, 1.0, None, true).unwrap();
+        assert!(r.validate_context(1048576).is_ok());
+        assert!(r.validate_context(1048577).is_err());
+        for n in [262144, 524288, 1048576, 1048577] { for fmt in 0..5 {
+            let g = pack_geometry(64, n, fmt);
+            assert_eq!(g & 255, 64);
+            assert_eq!((g >> 8) & 0x0fff_ffff, n as u64);
+            assert_eq!(g >> 36, fmt as u64);
+        }}
+        for stride in [262145usize, 1048576, 1048577] {
+            for pitch in [0usize, 640, 1280] {
+                let g = crate::qwen::pack_qsa_geometry(stride, pitch, stride / 4);
+                assert_eq!(g & 0x3fffff, stride as u64);
+                assert_eq!((g >> 22) & 0x3ffff, pitch as u64);
+                assert_eq!((g >> 40) & 0xfffff, (stride / 4) as u64);
+            }
+        }
+        for factor in [f32::NAN, f32::INFINITY, 0.5] {
+            assert!(Rope::new(64, 1e7, 262144, factor, 32.0, 1.0, None, true).is_err());
+        }
+    }
+    #[test]
+    fn yarn_frequency_bands_and_mrope() {
+        let r = Rope::new(64, 1e7, 262144, 4.0, 32.0, 1.0, None, true).unwrap();
+        assert_eq!(r.inv[0], 1.0);
+        assert!((r.inv[31] / (1.0 / 1e7f32.powf(62.0 / 64.0)) - 0.25).abs() < 1e-6);
+        assert!((r.scale - 1.1386294).abs() < 1e-6);
+        assert_eq!(r.rows(1048575, 1), r.row([1048575; 3], [11, 11, 10]));
+        let a = r.row([262143, 524287, 1048575], [11, 11, 10]);
+        for i in 0..32 {
+            let axis = if i % 3 == 1 { 524287 } else if i % 3 == 2 && i < 30 { 1048575 } else { 262143 };
+            assert_eq!(a[i], r.row([axis; 3], [0; 3])[i]);
+        }
+    }
+}
