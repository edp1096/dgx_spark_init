+
+// Explicitly opt into these real GB10 kernel tests: cargo test --release --test exl3_yarn_gpu -- --ignored --nocapture
+#[test]
+#[ignore = "requires GB10 CUDA device and rebuilt PTX"]
+fn kv_writers_across_native_and_one_meg_boundaries() -> Result<()> {
+    let dev = CudaDevice::new(0)?;
+    let names = ["xq_attn_kv_prefill", "xq_attn_kv_prefill_rows", "xq_attn_kv_rows_dn"];
+    let ptx = std::fs::read_to_string("src/ptx/exl3_bench.ptx")?;
+    dev.load_ptx(cudarc::nvrtc::Ptx::from_src(ptx), "yarn_kv_test", &names)?;
+    let rope = Rope::new(64, 1e7, 262144, 4.0, 32.0, 1.0, None, true)?;
+    let hd = 64usize;
+    let hbits = |v:f32| f16::from_f32(v).to_bits();
+    let k = dev.htod_sync_copy(&(0..2*hd).map(|i| hbits((i as f32+1.0)/128.0)).collect::<Vec<_>>())?;
+    let v = dev.htod_sync_copy(&(0..2*hd).map(|i| hbits((i as f32+1.0)/64.0)).collect::<Vec<_>>())?;
+    let norm = dev.htod_sync_copy(&vec![hbits(0.0);2*hd])?;
+    let nkv_hd = 1i32 | ((hd as i32)<<16);
+    let mut passed = 0;
+    for max_pos in [262145usize,1048576,1048577,1048584] {
+        let p = max_pos-2;
+        let cs = dev.htod_sync_copy(&rope.rows(p,2))?;
+        for fmt in 0..4 {
+            let rb = kv_rowbytes(fmt,hd);
+            let run = |name:&str, n:usize, pos:usize| -> Result<Vec<u8>> {
+                let mut cache = dev.htod_sync_copy(&vec![0u8;2*n*rb])?;
+                let geom = pack_geometry(64,n,fmt);
+                let f = dev.get_func("yarn_kv_test",name).unwrap();
+                let launch = LaunchConfig{grid_dim:(if name.ends_with("_rows"){2}else{1},1,1),block_dim:(hd as u32,1,1),shared_mem_bytes:0};
+                if name=="xq_attn_kv_rows_dn" {
+                    let meta = dev.htod_sync_copy(&[0i32,pos as i32,2,0])?;
+                    unsafe { f.launch(launch,(&k,&v,&mut cache,&norm,&cs,nkv_hd,geom,&meta,2i32,1e-6f32))?; }
+                } else {
+                    let slot_pos = (pos as u64)<<12;
+                    unsafe { f.launch(launch,(&k,&v,&mut cache,&norm,&cs,nkv_hd,geom,slot_pos,2i32,1e-6f32))?; }
+                }
+                dev.synchronize()?;
+                let bytes = dev.dtoh_sync_copy(&cache)?;
+                ensure!(bytes[..pos*rb].iter().all(|&b| b==0),"unexpected K write before position {pos}");
+                ensure!(bytes[n*rb..(n+pos)*rb].iter().all(|&b|b==0),"unexpected V write before position {pos}");
+                let mut out=bytes[pos*rb..(pos+2)*rb].to_vec();
+                out.extend_from_slice(&bytes[(n+pos)*rb..(n+pos+2)*rb]);
+                ensure!(out.iter().any(|&b|b!=0),"empty KV write");
+                if fmt==0 {
+                    for t in 0..2 { for i in 0..hd {
+                        let off=2*rb+t*rb+i*4;
+                        let got=f32::from_le_bytes(out[off..off+4].try_into().unwrap());
+                        ensure!(got==f16::from_f32((t*hd+i+1) as f32/64.0).to_f32(),"F32 V value mismatch");
+                    }}
+                }
+                Ok(out)
+            };
+            let expected = run(names[0],4,1)?;
+            for name in names {
+                ensure!(run(name,max_pos,p)?==expected,"KV bytes differ: {name} fmt={fmt} max_pos={max_pos}");
+                passed+=1;
+            }
+        }
+    }
+    println!("YARN_GPU_KV_PASS cases={passed} (all formats; native, 1M, 1M+headroom; serial/parallel/MTP-reprime)");
+    Ok(())
+}
