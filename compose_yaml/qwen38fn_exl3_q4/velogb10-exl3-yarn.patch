+#[test]
+#[ignore = "requires GB10 CUDA device and rebuilt PTX"]
+fn qsa_query_pitch_and_slot_stride_across_one_meg() -> Result<()> {
+    use half::bf16;
+    use gb10_inference::qwen::pack_qsa_geometry;
+    let dev = CudaDevice::new(0)?;
+    let names=["qsa_score_b","qsa_score_pooled_b","qsa_score_pooled_mr"];
+    dev.load_ptx(cudarc::nvrtc::Ptx::from_src(std::fs::read_to_string("src/ptx/gpu_batch.ptx")?),"yarn_qsa_test",&names)?;
+    let (hd,heads,pitch,m,nb)=(128usize,4usize,640usize,4usize,2usize);
+    let q:Vec<u16>=(0..m*pitch).map(|i|bf16::from_f32((1+(i*13)%29) as f32/16.0).to_bits()).collect();
+    let query=dev.htod_sync_copy(&q)?;
+    let positions=dev.htod_sync_copy(&vec![8i32;m])?;
+    let slots=dev.htod_sync_copy(&[0i32,1,0,1])?;
+    let cos=dev.htod_sync_copy(&vec![1f32;9*64])?;
+    let sin=dev.htod_sync_copy(&vec![0f32;9*64])?;
+    let norm=dev.htod_sync_copy(&vec![0f32;hd])?;
+    use cudarc::driver::DevicePtr;
+    let mut param=Vec::new();
+    for p in [*cos.device_ptr(),*sin.device_ptr(),*norm.device_ptr(),*norm.device_ptr()] {param.extend_from_slice(&p.to_le_bytes());}
+    param.extend_from_slice(&1e-6f32.to_le_bytes());
+    for v in [hd,heads,64,4,512,2051,0] {param.extend_from_slice(&(v as i32).to_le_bytes());}
+    param.extend_from_slice(&0u64.to_le_bytes());
+    let params=dev.htod_sync_copy(&param)?;
+    let run=|name:&str,stride:usize|->Result<Vec<f32>> {
+        let blocks=(stride/4).max(1);
+        let raw=name=="qsa_score_b";
+        let key_stride=if raw {stride}else{blocks};
+        let written=if raw {nb*4}else{nb};
+        let mut host=vec![0u16;2*key_stride*hd];
+        for s in 0..2 {for j in 0..written {for d in 0..hd {
+            host[(s*key_stride+j)*hd+d]=bf16::from_f32((1+(s*19+j*7+d*3)%31) as f32/32.0).to_bits();
+        }}}
+        let keys=dev.htod_sync_copy(&host)?;drop(host);
+        let mut scores=dev.alloc_zeros::<f32>(m*blocks)?;
+        let geom=pack_qsa_geometry(stride,pitch,blocks) as i64;
+        let f=dev.get_func("yarn_qsa_test",name).unwrap();
+        if name=="qsa_score_pooled_mr" {
+            unsafe{f.launch(LaunchConfig{grid_dim:(4,1,1),block_dim:(256,1,1),shared_mem_bytes:(m*heads*hd*4) as u32},
+                (&mut scores,&query,&keys,&positions,&slots,&params,geom,m as i32))?;}
+        } else if raw {
+            unsafe{f.launch(LaunchConfig{grid_dim:(1,m as u32,1),block_dim:(256,1,1),shared_mem_bytes:0},
+                (&mut scores,&query,&keys,&positions,&slots,0u64,0u64,&params,geom))?;}
+        } else {
+            unsafe{f.launch(LaunchConfig{grid_dim:(1,m as u32,1),block_dim:(256,1,1),shared_mem_bytes:0},
+                (&mut scores,&query,&keys,&positions,&slots,&params,geom))?;}
+        }
+        dev.synchronize()?;
+        let all=dev.dtoh_sync_copy(&scores)?;
+        let mut out=Vec::new();
+        for r in 0..m {out.extend_from_slice(&all[r*blocks..r*blocks+nb]);}
+        ensure!(out.iter().all(|v|v.is_finite() && *v>0.0),"invalid QSA scores");
+        Ok(out)
+    };
+    let mut passed=0;
+    for name in names {
+        let reference=run(name,9)?;
+        for stride in [262145usize,1048576,1048577] {
+            ensure!(run(name,stride)?==reference,"QSA pitch/slot mismatch: {name} stride={stride}");
+            passed+=1;
+        }
+    }
+    println!("YARN_GPU_QSA_PASS cases={passed} (4 distinct query rows, 2 slots, raw/pooled/persistent scorers)");
+    Ok(())
+}
