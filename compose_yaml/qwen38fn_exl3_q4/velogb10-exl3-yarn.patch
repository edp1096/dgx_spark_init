+#[test]
+#[ignore = "requires GB10 CUDA device and rebuilt PTX"]
+fn qsa_selection_keeps_full_width_indices_at_one_meg() -> Result<()> {
+    let dev=CudaDevice::new(0)?;
+    let names=["xq_qsa_topk_asc","xq_qsa_topk_asc2","xq_qsa_topk_asc3"];
+    dev.load_ptx(cudarc::nvrtc::Ptx::from_src(std::fs::read_to_string("src/ptx/exl3_bench.ptx")?),"yarn_select_test",&names)?;
+    let mut param=vec![0u8;32];param.extend_from_slice(&1e-6f32.to_le_bytes());
+    for v in [128i32,4,64,4,512,2051,0] {param.extend_from_slice(&v.to_le_bytes());}
+    param.extend_from_slice(&0u64.to_le_bytes());
+    let params=dev.htod_sync_copy(&param)?;
+    let mut passed=0;
+    for pos in [262143usize,262144,1048575,1048576] {
+        let nb=(pos+1)/4;let tail=(pos+1)%4;
+        let positions=dev.htod_sync_copy(&[pos as i32])?;
+        for kind in 0..3 {
+            let scores:Vec<f32>=(0..nb).map(|j|match kind {0=>j as f32,1=>1.0,_=>((j as u32).wrapping_mul(2654435761)%257) as f32}).collect();
+            let mut order:Vec<usize>=(0..nb).collect();
+            order.sort_unstable_by(|&a,&b|scores[b].total_cmp(&scores[a]).then(a.cmp(&b)));
+            order.truncate(512);order.sort_unstable();
+            let mut expected=Vec::new();
+            for j in order {for r in 0..4 {expected.push((j*4+r) as i32);}}
+            for r in 0..tail {expected.push((nb*4+r) as i32);}
+            // The vectorized scorer reads quads; allocate the final padded quad too.
+            let mut padded=scores.clone();padded.resize(nb.div_ceil(4)*4,0.0);
+            let scores_dev=dev.htod_sync_copy(&padded)?;
+            for name in names {
+                let mut sel=dev.htod_sync_copy(&vec![-1i32;2051])?;
+                let mut end=dev.htod_sync_copy(&[-1i32])?;
+                let f=dev.get_func("yarn_select_test",name).unwrap();
+                unsafe{f.launch(LaunchConfig{grid_dim:(1,1,1),block_dim:(1024,1,1),shared_mem_bytes:0},
+                    (&mut sel,&mut end,&scores_dev,&positions,&params,nb as i32,0i32))?;}
+                dev.synchronize()?;
+                let got=dev.dtoh_sync_copy(&sel)?;
+                let last=dev.dtoh_sync_copy(&end)?[0];
+                ensure!(last+1==expected.len() as i32 && got[..expected.len()]==expected,
+                        "QSA top-k differs from independent CPU sort: {name} pos={pos} pattern={kind}");
+                passed+=1;
+            }
+        }
+    }
+    println!("YARN_GPU_SELECT_PASS cases={passed} (native/1M boundaries; high indices, ties, all-equal scores)");
+    Ok(())
+}
