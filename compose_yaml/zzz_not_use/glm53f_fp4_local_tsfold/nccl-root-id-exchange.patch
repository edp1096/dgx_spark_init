@@ -159,10 +160,26 @@ fn openRank(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: [
     // NCCL's cuMem host buffers wore out GB10's driver pool under load (NV_ERR_NO_MEMORY; next ranks failed to start)
     if (std.c.getenv("NCCL_CUMEM_HOST_ENABLE") == null) _ = setenv("NCCL_CUMEM_HOST_ENABLE", "0", 0);
     if (std.c.getenv("NCCL_CUMEM_ENABLE") == null) _ = setenv("NCCL_CUMEM_ENABLE", "0", 0);
+    // NCCL's manual NCCL_COMM_ID subnet selection chose loopback on these hosts.
+    // Let NCCL honor NCCL_SOCKET_IFNAME and distribute its real root ID instead.
+    var endpoint_buffer: [256]u8 = undefined;
+    const endpoint: ?[:0]const u8 = if (std.c.getenv("NCCL_COMM_ID")) |raw| blk: {
+        const value = std.mem.span(raw);
+        if (value.len >= endpoint_buffer.len) return error.NoCommId;
+        @memcpy(endpoint_buffer[0..value.len], value);
+        endpoint_buffer[value.len] = 0;
+        break :blk endpoint_buffer[0..value.len :0];
+    } else null;
+    _ = unsetenv("NCCL_COMM_ID");
     var lib = try cuda.nccl.Library.open();
     errdefer lib.close();
     var id: cuda.nccl.UniqueId = undefined;
-    try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId"); // NCCL_COMM_ID: the same id on every rank
+    if (p.rank == 0) try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId");
+    if (p.world > 1) {
+        if (endpoint) |value| _ = setenv("NCCL_COMM_ID", value.ptr, 1) else return error.NoCommId;
+        defer _ = unsetenv("NCCL_COMM_ID");
+        try cuda.tp_watch.startWithId(io, p.rank, p.world, &id.internal);
+    }
     var comm: cuda.nccl.Comm = null;
     try lib.check(lib.api.ncclCommInitRank(&comm, @intCast(p.world), id, @intCast(p.rank)), "ncclCommInitRank");
     own.group = .{ .lib = lib, .comm = comm, .rank = p.rank, .world = p.world };
