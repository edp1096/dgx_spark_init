+def _load_local_image(rt_module, path: str):
+    """Load WebP through Pillow because the C++ image loader accepts PNG/JPEG."""
+    if Path(path).suffix.lower() != ".webp":
+        return rt_module.load_image_from_path(path)
+    from PIL import Image as PILImage
+    converted = io.BytesIO()
+    with PILImage.open(path) as webp:
+        webp.save(converted, format="PNG")
+    return rt_module.load_image_from_bytes(converted.getvalue())
