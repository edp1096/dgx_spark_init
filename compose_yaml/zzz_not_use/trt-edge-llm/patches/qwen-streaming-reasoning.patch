+class IncrementalQwenToolParser:
+    """Incrementally split Qwen XML output without leaking tool markup.
+
+    Qwen's tool template guarantees ``<tool_call>...</tool_call>`` blocks.
+    Ordinary answer and reasoning text can therefore be forwarded as soon as
+    it is safe, while only a possible marker suffix and an active tool block
+    need to be buffered.  Completed blocks still use the shared parser below,
+    keeping argument coercion and tool-name validation in one place.
+    """
+
+    _THINK_OPEN = "<think>"
+    _THINK_CLOSE = "</think>"
+    _TOOL_OPEN = "<tool_call>"
+    _TOOL_CLOSE = "</tool_call>"
+    _FUNCTION_OPEN = "<function="
+    _FUNCTION_CLOSE = "</function>"
+    _PROTOCOL_END_TOKENS = ("<|im_end|>", "<|endoftext|>")
+
+    def __init__(self,
+                 tool_config: ToolConfig,
+                 starts_in_reasoning: bool = False):
+        self._tool_config = tool_config
+        self._state = "reasoning" if starts_in_reasoning else "content"
+        self._buffer = ""
+        self._tool_block = ""
+        self._tool_close = self._TOOL_CLOSE
+        self._reasoning_text = ""
+
+    def feed(self, text: str) -> List[Dict[str, Any]]:
+        if text:
+            self._buffer += text
+        return self._drain(final=False)
+
+    def flush(self) -> List[Dict[str, Any]]:
+        return self._drain(final=True)
+
+    def _drain(self, *, final: bool) -> List[Dict[str, Any]]:
+        events: List[Dict[str, Any]] = []
+        while self._buffer:
+            if self._state == "content":
+                marker = self._first_marker(
+                    (self._THINK_OPEN, self._TOOL_OPEN,
+                     self._FUNCTION_OPEN) + self._PROTOCOL_END_TOKENS)
+                if marker is not None:
+                    index, value = marker
+                    if index:
+                        events.append({
+                            "type": "content",
+                            "text": self._buffer[:index],
+                        })
+                    self._buffer = self._buffer[index + len(value):]
+                    if value == self._THINK_OPEN:
+                        self._state = "reasoning"
+                    elif value not in self._PROTOCOL_END_TOKENS:
+                        self._start_tool(value)
+                    continue
+                safe = self._take_safe_prefix(
+                    (self._THINK_OPEN, self._TOOL_OPEN,
+                     self._FUNCTION_OPEN) + self._PROTOCOL_END_TOKENS, final)
+                if safe:
+                    events.append({"type": "content", "text": safe})
+                break
+
+            if self._state == "reasoning":
+                marker = self._first_marker(
+                    (self._THINK_CLOSE, self._TOOL_OPEN,
+                     self._FUNCTION_OPEN) + self._PROTOCOL_END_TOKENS)
+                if marker is not None:
+                    index, value = marker
+                    if index:
+                        events.append({
+                            "type": "reasoning",
+                            "text": self._buffer[:index],
+                        })
+                    self._buffer = self._buffer[index + len(value):]
+                    if value == self._THINK_CLOSE:
+                        self._state = "content"
+                    elif value not in self._PROTOCOL_END_TOKENS:
+                        self._start_tool(value)
+                    continue
+                safe = self._take_safe_prefix(
+                    (self._THINK_CLOSE, self._TOOL_OPEN,
+                     self._FUNCTION_OPEN) + self._PROTOCOL_END_TOKENS, final)
+                if safe:
+                    events.append({"type": "reasoning", "text": safe})
+                break
+
+            index = self._buffer.find(self._tool_close)
+            if index >= 0:
+                self._tool_block += (self._buffer[:index] +
+                                     self._tool_close)
+                self._buffer = self._buffer[index + len(self._tool_close):]
+                events.extend(self._parse_tool_block_or_content(
+                    self._tool_block))
+                self._tool_block = ""
+                self._state = "content"
+                continue
+            if final:
+                self._tool_block += self._buffer
+                self._buffer = ""
+                events.extend(self._parse_tool_block_or_content(
+                    self._tool_block))
+                self._tool_block = ""
+                self._state = "content"
+            else:
+                self._tool_block += self._take_safe_prefix(
+                    (self._tool_close, ), final=False)
+            break
+        if final and self._state == "tool" and self._tool_block:
+            events.extend(self._parse_tool_block_or_content(self._tool_block))
+            self._tool_block = ""
+            self._state = "content"
+        self._reasoning_text += "".join(
+            event["text"] for event in events
+            if event["type"] == "reasoning")
+        if final and self._state == "reasoning" and self._reasoning_text:
+            # Some Qwen checkpoints end with EOS without emitting </think>.
+            # Preserve the reasoning channel already streamed, but also give
+            # OpenAI clients a non-empty final answer instead of losing the
+            # entire response in a hidden reasoning drawer.
+            events.append({
+                "type": "content",
+                "text": self._reasoning_text,
+            })
+            self._state = "content"
+        return events
+
+    def _start_tool(self, marker: str) -> None:
+        self._state = "tool"
+        self._tool_block = marker
+        self._tool_close = (self._FUNCTION_CLOSE
+                            if marker == self._FUNCTION_OPEN else
+                            self._TOOL_CLOSE)
+
+    def _first_marker(self, markers: Sequence[str]) -> Optional[Tuple[int,
+                                                                      str]]:
+        found = [(index, marker) for marker in markers
+                 if (index := self._buffer.find(marker)) >= 0]
+        return min(found, key=lambda item: item[0]) if found else None
+
+    def _take_safe_prefix(self, markers: Sequence[str], final: bool) -> str:
+        if final:
+            safe, self._buffer = self._buffer, ""
+            return safe
+        keep = 0
+        for marker in markers:
+            limit = min(len(self._buffer), len(marker) - 1)
+            for size in range(limit, 0, -1):
+                if marker.startswith(self._buffer[-size:]):
+                    keep = max(keep, size)
+                    break
+        if keep:
+            safe, self._buffer = self._buffer[:-keep], self._buffer[-keep:]
+        else:
+            safe, self._buffer = self._buffer, ""
+        return safe
+
+    def _parse_tool_block_or_content(
+            self, block: str) -> List[Dict[str, Any]]:
+        calls = _parse_tool_block(block, self._tool_config)
+        if calls:
+            return [{"type": "tool_call", "tool_call": call}
+                    for call in calls]
+        return [{"type": "content", "text": block}]
+
+
+def _model_chat_template(model_dir: str) -> str:
+    try:
+        with open(os.path.join(model_dir, "tokenizer_config.json"),
+                  encoding="utf-8") as f:
+            template = json.load(f).get("chat_template", "")
+    except (OSError, ValueError, AttributeError):
+        return ""
+    return template if isinstance(template, str) else ""
+
+
+def thinking_starts_in_prompt(model_dir: str) -> bool:
+    """Whether this tokenizer's generation prompt pre-opens ``<think>``."""
+    template = _model_chat_template(model_dir)
+    return ("add_generation_prompt" in template
+            and "{{- '<think>\\n' }}" in template)
+
+
+def incremental_tool_parser(model_dir: str,
+                            tool_config: ToolConfig,
+                            enable_thinking: bool = False
+                            ) -> Optional[IncrementalQwenToolParser]:
+    """Return the narrow streaming parser only for a matching Qwen template.
+
+    Other model protocols retain the existing whole-response parser.  This
+    avoids prematurely exposing raw JSON or Python-style calls as user-facing
+    content when their output format has no unambiguous opening delimiter.
+    """
+    template = _model_chat_template(model_dir)
+    required = (
+        "<tool_call>",
