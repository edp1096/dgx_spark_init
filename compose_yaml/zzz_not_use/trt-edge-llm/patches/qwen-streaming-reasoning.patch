+def _reasoning_control(body: Dict[str, Any]) -> Tuple[bool, Optional[str]]:
+    """Resolve OpenAI-style effort into Edge-LLM's thinking controls.
+
+    Qwen3.8 exposes low/medium/xhigh in its tokenizer template, while clients
+    commonly send the wider none/minimal/low/medium/high/xhigh/max vocabulary
+    (or a 0..1 effort).  Preserve the three native levels and map adjacent
+    client values deterministically.  An explicit ``enable_thinking`` boolean
+    controls on/off and takes precedence over the effort-derived state.
+    """
+    explicit = body.get("enable_thinking")
+    if explicit is not None and not isinstance(explicit, bool):
+        raise ValueError("'enable_thinking' must be a boolean")
+
+    raw = body.get("reasoning_effort")
+    enabled_from_effort = False
+    normalized: Optional[str] = None
+    if raw is not None:
+        if isinstance(raw, bool):
+            raise ValueError(
+                "'reasoning_effort' must be a name or a number in [0, 1]")
+        if isinstance(raw, (int, float)):
+            value = float(raw)
+            if not math.isfinite(value) or not 0.0 <= value <= 1.0:
+                raise ValueError("'reasoning_effort' must be in [0, 1]")
+            enabled_from_effort = value > 0.0
+            if enabled_from_effort:
+                normalized = ("low" if value < 1 / 3 else
+                              "medium" if value < 2 / 3 else "xhigh")
+        elif isinstance(raw, str):
+            value = raw.strip().lower()
+            if value in ("", "none", "off", "false"):
+                enabled_from_effort = False
+            elif value in ("minimal", "low"):
+                enabled_from_effort, normalized = True, "low"
+            elif value == "medium":
+                enabled_from_effort, normalized = True, "medium"
+            elif value in ("high", "xhigh", "max"):
+                enabled_from_effort, normalized = True, "xhigh"
+            else:
+                raise ValueError(
+                    "'reasoning_effort' must be none, minimal, low, medium, "
+                    "high, xhigh, max, or a number in [0, 1]")
+        else:
+            raise ValueError(
+                "'reasoning_effort' must be a name or a number in [0, 1]")
+
+    enabled = explicit if explicit is not None else enabled_from_effort
+    return enabled, normalized if enabled else None
+
+
