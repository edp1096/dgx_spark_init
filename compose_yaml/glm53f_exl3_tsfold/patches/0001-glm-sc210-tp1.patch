+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const dense = @import("cuda_exl3_dense.zig");
+
+fn tensor(ck: *core.Checkpoint, name: []const u8, suffix: []const u8) !core.checkpoint.Tensor {
+    var buf: [256]u8 = undefined;
+    return ck.get(try std.fmt.bufPrint(&buf, "{s}.{s}", .{ name, suffix }));
+}
+
+fn has(ck: *core.Checkpoint, name: []const u8, suffix: []const u8) bool {
+    var buf: [256]u8 = undefined;
+    return ck.has(std.fmt.bufPrint(&buf, "{s}.{s}", .{ name, suffix }) catch return false);
+}
+
+fn upload(L: anytype, t: core.checkpoint.Tensor, name: []const u8, suffix: []const u8) !u64 {
+    try L.host.appendSlice(L.gpa, t.bytes);
+    return L.put("exl3.{s}.{s}", .{ name, suffix });
+}
+
+fn part(L: anytype, ck: *core.Checkpoint, name: []const u8) !dense.Part {
+    if (has(ck, name, "weight")) {
+        const t = try tensor(ck, name, "weight");
+        if ((t.dtype != .bf16 and t.dtype != .f16) or t.rank != 2) return error.Exl3ProjectionShape;
+        try L.whole(t, .bf16); // The loader refuses FP16 values that cannot be represented exactly as BF16.
+        return .{ .bf16 = .{ .ptr = try L.put("exl3.{s}.weight", .{name}), .n = t.dim(0), .k = t.dim(1) } };
+    }
+    const t = try tensor(ck, name, "trellis");
+    if (t.dtype != .i16 or t.rank != 3 or t.dim(2) % 8 != 0) return error.BadExl3Trellis;
+    const k = t.dim(0) * 16;
+    const n = t.dim(1) * 16;
+    const halves = t.dim(2) / 8;
+    if (k % 128 != 0 or n % 128 != 0 or halves < 2 or halves > 16) return error.BadExl3Trellis;
+    var cb: cuda.exl3.Codebook = .inst3;
+    var found = false;
+    for (core.exl3_load.markers) |marker| if (has(ck, name, marker.name)) {
+        if (found) return error.BadExl3Codebook;
+        found = true;
+        const m = try tensor(ck, name, marker.name);
+        if (m.dtype != .i32 or m.bytes.len != 4 or std.mem.readInt(u32, m.bytes[0..4], .little) != marker.value)
+            return error.BadExl3Codebook;
+        cb = switch (marker.codebook) {
+            .inst3 => .inst3,
+            .mcg => .mcg,
+            .mul1 => .mul1,
+        };
+    };
+    if (halves % 2 != 0 and cb != .mul1) return error.BadExl3Trellis;
+    const su = try tensor(ck, name, "suh");
+    const sv = try tensor(ck, name, "svh");
+    if (su.dtype != .f16 or su.numel() != k or sv.dtype != .f16 or sv.numel() != n) return error.BadExl3Scales;
+    const st = cuda.exl3.strides(k, n, halves, false);
+    var w: cuda.exl3.Weight = .{ .trellis = try upload(L, t, name, "trellis"), .suh = try upload(L, su, name, "suh"), .svh = try upload(L, sv, name, "svh"), .k = @intCast(k), .n = @intCast(n), .halves = @intCast(halves), .codebook = cb, .stride_k = st.k, .stride_nb = st.nb };
+    if (has(ck, name, "bias")) {
+        const b = try tensor(ck, name, "bias");
+        if (b.dtype != .f16 or b.numel() != n) return error.BadExl3Bias;
+        w.bias = try upload(L, b, name, "bias");
+    }
+    return .{ .exl3 = w };
+}
+
+pub fn load(L: anytype, ck: *core.Checkpoint, name: []const u8, suffixes: []const []const u8) !u64 {
+    if (L.w.share.world != 1) return error.Exl3DenseRequiresTp1;
+    if (suffixes.len == 0 or suffixes.len > 4 or L.host.items.len != 0) return error.Exl3ProjectionShape;
+    var e: dense.Entry = .{ .handle = 0x1000000000000000 + L.w.xlinears.items.len, .parts = undefined, .count = suffixes.len, .n = 0, .k = 0 };
+    for (suffixes, 0..) |suffix, i| {
+        var buf: [256]u8 = undefined;
+        const full = if (suffix.len == 0) name else try std.fmt.bufPrint(&buf, "{s}.{s}", .{ name, suffix });
+        e.parts[i] = try part(L, ck, full);
+        if (i == 0) e.k = e.parts[i].k();
+        if (e.parts[i].k() != e.k) return error.Exl3ProjectionShape;
+        e.n += e.parts[i].n();
+    }
+    try L.w.xlinears.append(L.gpa, e);
+    return e.handle;
+}
