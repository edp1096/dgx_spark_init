diff --git a/zig/src/families/glm/cuda_exl3_dense.zig b/zig/src/families/glm/cuda_exl3_dense.zig
new file mode 100644
index 00000000..e3e5e816
--- /dev/null
+++ b/zig/src/families/glm/cuda_exl3_dense.zig
@@ -0,0 +1,131 @@
+//! Stored EXL3 projections and mixed output stacks for GLM's TP1 CUDA path.
+const std = @import("std");
+const cuda = @import("cuda");
+const glue = @import("cuda_glue.zig");
+const b16 = @import("cuda_b16.zig");
+
+pub const Part = union(enum) {
+    bf16: struct { ptr: u64, n: usize, k: usize },
+    exl3: cuda.exl3.Weight,
+
+    pub fn n(p: Part) usize {
+        return switch (p) {
+            .bf16 => |v| v.n,
+            .exl3 => |v| v.n,
+        };
+    }
+    pub fn k(p: Part) usize {
+        return switch (p) {
+            .bf16 => |v| v.k,
+            .exl3 => |v| v.k,
+        };
+    }
+};
+
+pub const Entry = struct {
+    handle: u64,
+    parts: [4]Part,
+    count: usize,
+    n: usize,
+    k: usize,
+};
+
+pub fn find(entries: []const Entry, handle: u64) ?*const Entry {
+    const base: u64 = 0x1000000000000000;
+    if (handle < base or handle - base >= entries.len) return null;
+    const e = &entries[@intCast(handle - base)];
+    return if (e.handle == handle) e else null;
+}
+
+fn copyRows(s: cuda.Stream, dst: u64, dp: usize, src: u64, sp: usize, width: usize, rows: usize) !void {
+    const m: cuda.abi.Memcpy2D = .{ .src = src, .src_pitch = sp, .dst = dst, .dst_pitch = dp, .width = width, .height = rows };
+    try s.d.check(s.d.api.cuMemcpy2DAsync_v2(&m, s.handle), "GLM EXL3 projection rows");
+}
+
+pub const Runtime = struct {
+    entries: []const Entry,
+    dense: cuda.exl3.Dense,
+    input: cuda.DeviceBuffer,
+    output: cuda.DeviceBuffer,
+
+    pub fn init(d: *const cuda.Driver, entries: []const Entry) !Runtime {
+        var dense = try cuda.exl3.Dense.load(d);
+        errdefer dense.unload();
+        var max_k: usize = 128;
+        var max_n: usize = 128;
+        var z: usize = 256;
+        var counters: usize = 256;
+        for (entries) |e| for (e.parts[0..e.count]) |part| {
+            max_k = @max(max_k, part.k());
+            max_n = @max(max_n, part.n());
+            if (part == .exl3) {
+                z = @max(z, cuda.exl3.Linear.zBytes(part.exl3, 128));
+                counters = @max(counters, cuda.exl3.Linear.counterBytes(part.exl3));
+            }
+        };
+        // Reserve every served projection before graph capture; calls never grow or invalidate scratch.
+        dense.xh = try cuda.DeviceBuffer.alloc(d, 128 * max_k * 2);
+        dense.z = try cuda.DeviceBuffer.alloc(d, z);
+        dense.counters = try cuda.DeviceBuffer.alloc(d, counters);
+        var input = try cuda.DeviceBuffer.alloc(d, 128 * max_k * 2);
+        errdefer input.free();
+        var output = try cuda.DeviceBuffer.alloc(d, 128 * max_n * 4);
+        errdefer output.free();
+        if (std.c.getenv("TF_GLM_EXL3_DENSE")) |v| {
+            const mode = std.mem.span(v);
+            if (std.mem.eql(u8, mode, "tiles")) {
+                var mod = try cuda.Module.load(d, cuda.kernels.exl3_candidate);
+                errdefer mod.unload();
+                dense.candidate_k = try cuda.exl3_candidate.Kernels.resolve(d, mod, max_k);
+                dense.candidate_mod = mod;
+                dense.implementation = .tiles;
+            } else if (!std.mem.eql(u8, mode, "reference")) return error.BadExl3DenseMode;
+        }
+        return .{ .entries = entries, .dense = dense, .input = input, .output = output };
+    }
+
+    pub fn deinit(r: *Runtime) void {
+        r.dense.unload();
+        r.input.free();
+        r.output.free();
+    }
+
+    pub fn run(r: *Runtime, set: glue.Set, s: cuda.Stream, e: *const Entry, x: u64, stride: usize, out: u64, partial: u64, rows: usize, n: usize, k: usize, wide: bool) !void {
+        if (n != e.n or k != e.k or stride < k) return error.Exl3ProjectionShape;
+        const element: usize = if (wide) 4 else 2;
+        var at: usize = 0;
+        while (at < rows) : (at += 128) {
+            const count = @min(rows - at, 128);
+            var source = x + at * stride * 2;
+            if (stride != k) {
+                try copyRows(s, r.input.ptr, k * 2, source, stride * 2, k * 2, count);
+                source = r.input.ptr;
+            }
+            var column: usize = 0;
+            for (e.parts[0..e.count]) |part| {
+                const dest = if (e.count == 1) out + at * n * element else r.output.ptr;
+                switch (part) {
+                    .exl3 => |w| {
+                        if (set.prompt) try r.dense.prompt(s, w, source, .bf16, count, dest, if (wide) .f32 else .bf16) else try r.dense.decode(s, w, source, .bf16, count, dest, if (wide) .f32 else .bf16);
+                    },
+                    .bf16 => |w| {
+                        var raw = set;
+                        raw.exl3 = null;
+                        raw.mm = null; // Mixed stacks keep their small BF16 components in row-major order.
+                        try b16.rawMatmul(raw, s, source, k, w.ptr, dest, partial, count, w.n, w.k, wide);
+                    },
+                }
+                if (e.count > 1)
+                    try copyRows(s, out + (at * n + column) * element, n * element, dest, part.n() * element, part.n() * element, count);
+                column += part.n();
+            }
+        }
+    }
+};
+
+test "projection handles identify owned descriptors and reject ordinary device pointers" {
+    const e = [_]Entry{.{ .handle = 0x1000000000000000, .parts = undefined, .count = 0, .n = 128, .k = 128 }};
+    try std.testing.expect(find(&e, 0x1000000000000000) != null);
+    try std.testing.expect(find(&e, 0x1000000000000001) == null);
+    try std.testing.expect(find(&e, 0x12340000) == null);
+}
