ARG RUNTIME_BASE_IMAGE=ubuntu:24.04
FROM ${RUNTIME_BASE_IMAGE} AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends golang-go ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ssh ./cmd/ssh
RUN CGO_ENABLED=0 go test ./cmd/ssh \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sparktalk-extra-ssh ./cmd/ssh

FROM ${RUNTIME_BASE_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/edp1096/dgx_spark_init"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/sparktalk-extra-ssh /usr/local/bin/sparktalk-extra-ssh
EXPOSE 8699
ENTRYPOINT ["/usr/local/bin/sparktalk-extra-ssh"]
