ARG RUNTIME_BASE_IMAGE=ubuntu:24.04
FROM golang:1.25-bookworm AS builder
WORKDIR /src
COPY go.mod ./
COPY go.sum ./
COPY cmd/media ./cmd/media
RUN CGO_ENABLED=0 go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sparktalk-extra-media ./cmd/media

FROM ${RUNTIME_BASE_IMAGE} AS tools
ARG TARGETARCH
ARG YTDLP_VERSION=2026.08.19
# Release commit: 3a08beaf031ab68f966401ead017ac81fe8486cf.
# Pin the tested artifacts locally; do not trust a mutable remote checksum file.
ARG YTDLP_SHA256_AMD64=58162f9bfdc27458ea47bfcb311cf47028f17d8154a8bf7d689861d46399230a
ARG YTDLP_SHA256_ARM64=b16e4dab368a816cd05d477d698a605a6ae87ccee1c8ffd38fa21d7254141fcc
ARG DENO_VERSION=2.8.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
         amd64) ytdlp_asset=yt-dlp_linux; ytdlp_sha=${YTDLP_SHA256_AMD64}; deno_asset=deno-x86_64-unknown-linux-gnu.zip ;; \
         arm64) ytdlp_asset=yt-dlp_linux_aarch64; ytdlp_sha=${YTDLP_SHA256_ARM64}; deno_asset=deno-aarch64-unknown-linux-gnu.zip ;; \
         *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSLo /tmp/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/${ytdlp_asset}" \
    && test -n "${ytdlp_sha}" \
    && echo "${ytdlp_sha}  /tmp/yt-dlp" | sha256sum -c - \
    && chmod 0555 /tmp/yt-dlp \
    && curl -fsSLo "/tmp/${deno_asset}" "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/${deno_asset}" \
    && curl -fsSLo "/tmp/${deno_asset}.sha256sum" "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/${deno_asset}.sha256sum" \
    && deno_sha="$(awk '{print $1}' "/tmp/${deno_asset}.sha256sum")" \
    && test -n "${deno_sha}" \
    && echo "${deno_sha}  /tmp/${deno_asset}" | sha256sum -c - \
    && unzip -q "/tmp/${deno_asset}" -d /tmp/deno-bin \
    && chmod 0555 /tmp/deno-bin/deno

FROM ${RUNTIME_BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/edp1096/dgx_spark_init"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/sparktalk-extra-media /usr/local/bin/sparktalk-extra-media
COPY --from=tools /tmp/yt-dlp /usr/local/bin/yt-dlp
COPY --from=tools /tmp/deno-bin/deno /usr/local/bin/deno

EXPOSE 8698
ENTRYPOINT ["/usr/local/bin/sparktalk-extra-media"]
