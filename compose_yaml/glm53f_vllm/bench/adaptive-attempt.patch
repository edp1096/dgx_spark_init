 [[ -n "${MIXED_PREFILL_CAP:-}" ]] && args+=(--mixed-prefill-token-cap "$MIXED_PREFILL_CAP")
 [[ "${SKIP_MM_PROFILING:-1}" != 0 ]] && args+=(--skip-mm-profiling)
 [[ "${ENFORCE_EAGER:-0}" != 0 ]] && args+=(--enforce-eager)
+if [[ -n "${CUDA_GRAPH_CAPTURE_SIZES:-}" ]]; then
+  read -r -a capture_sizes <<<"$CUDA_GRAPH_CAPTURE_SIZES"
+  for size in "${capture_sizes[@]}"; do
+    [[ "$size" =~ ^[1-9][0-9]*$ ]] || { echo 'CUDA_GRAPH_CAPTURE_SIZES must contain positive integers' >&2; exit 2; }
+  done
+  args+=(--cudagraph-capture-sizes "${capture_sizes[@]}")
+fi
 
+if [[ "${ADAPTIVE_SPECULATIVE_TOKENS_WINDOW:-0}" != 0 ]] && \
+   { [[ "${MTP_TOKENS:-0}" != 0 ]] || [[ "${SPEC_METHOD:-dflash}" != dflash ]]; }; then
+  echo 'ADAPTIVE_SPECULATIVE_TOKENS_WINDOW requires DFlash in this recipe' >&2
+  exit 2
+fi
 if [[ "${MTP_TOKENS:-0}" != 0 ]]; then
   args+=(--speculative-config "{\"method\":\"mtp\",\"num_speculative_tokens\":${MTP_TOKENS}}")
 elif [[ "${SPEC_METHOD:-dflash}" == dflash ]]; then
@@ -83,7 +95,19 @@ elif [[ "${SPEC_METHOD:-dflash}" == dflash ]]; then
