+import json, os
+window = int(os.environ.get('ADAPTIVE_SPECULATIVE_TOKENS_WINDOW', '0'))
+if window < 0:
+    raise SystemExit('ADAPTIVE_SPECULATIVE_TOKENS_WINDOW must be zero or positive')
+config = {'method': 'dflash', 'model': '/models/glm53-dflash2',
+          'num_speculative_tokens': int(os.environ.get('DFLASH_TOKENS', '7'))}
+if window:
+    config['adaptive_speculative_tokens_window'] = window
+print(json.dumps(config))
+PY
+)"
+  args+=(--speculative-config "$spec_config")
 fi
 
 args+=("${headless[@]}")
