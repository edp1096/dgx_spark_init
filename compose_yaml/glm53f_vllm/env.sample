# 두 Spark에서 동일한 모델 경로를 사용합니다. 실제 NIC/HCA 이름을 확인하세요.
MODEL_KIND=glm53
MODEL_VARIANT=official
HF_CACHE=${HOME}/.cache/huggingface
GLM53_IMAGE=pilcothink/vllm_spark_glm53@sha256:09da6eb394216d174ab8692758d90f9f458398d9c8fbc11ba6f04e93d5cf6392
GLM53_CACHE_PATH=${HOME}/.cache/glm53-nvfp4
HEAD_LAN_IP=192.168.100.61
WORKER_LAN_IP=192.168.100.60
WORKER_USER=${USER}
REMOTE_COMPOSE_DIR=${HOME}/workspace/dgx_spark_init/compose_yaml/glm53f_vllm
HEAD_RAIL_IP=10.200.0.1
WORKER_RAIL_IP=10.200.0.2
HEAD_NCCL_IF=enp1s0f1np1
WORKER_NCCL_IF=enp1s0f1np1
HEAD_NCCL_HCA=rocep1s0f1
WORKER_NCCL_HCA=rocep1s0f1
NCCL_SUBNET=10.200.0.0/24
NCCL_NCHANNELS=auto
NCCL_DEBUG=WARN
API_PORT=8000
MASTER_PORT=29521
VLLM_BIND=127.0.0.1
SERVED_MODEL_NAME=glm-5.3-flash
# TP2 1M · DFlash2 K5 · CUDA Graph · FP8 KV 약 9.54GiB/호스트.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=1024
GPU_MEMORY_UTILIZATION=0.88
KV_CACHE_DTYPE=fp8
KV_CACHE_MEMORY=10240000000
ENFORCE_EAGER=0
MTP_TOKENS=0
DFLASH_TOKENS=5
MAX_CUDAGRAPH_CAPTURE_SIZE=16
PREFIX_CACHE_RETENTION_INTERVAL=4608
